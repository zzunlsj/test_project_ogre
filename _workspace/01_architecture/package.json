{
  "name": "ogre-web-game",
  "version": "0.1.0",
  "type": "module",
  "description": "OGRE by Steve Jackson - Web port (Phaser 3 + TypeScript + Vite). Mk.III scenario with CRT-style Apple II green phosphor visuals.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^3.70.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "browserslist": [
    "Chrome >= 90",
    "Safari >= 15",
    "Firefox >= 90",
    "Edge >= 90"
  ]
}
